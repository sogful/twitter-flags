{
  "manifest_version": 3,
  "name": "twitter flags & more",
  "version": "2.2",
  "description": "browse hidden stuff inside the twitter client with a side panel!",
  "author": "cv",
  "homepage_url": "https://coolsite.cv",
  "browser_specific_settings": {
    "gecko": {
      "id": "cv@soggy.cat",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "twitter flags & more",
    "default_icon": {
      "16": "images/action16.png",
      "48": "images/action48.png"
    }
  },
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "sidebar_action": {
    "default_panel": "panel.html",
    "default_title": "twitter flags & more",
    "default_icon": {
      "16": "images/action16.png",
      "48": "images/action48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/inject.js", "src/dev.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
